{
  "strategy_name": "Market Cipher Blue Dot Basic",
  "version": "1.0.0",
  "description": "Basic strategy using Market Cipher blue dot signals with money flow confirmation. Designed for swing trading on higher timeframes.",
  "author": "The Black Wealth Capital Project",
  "created_at": "2025-02-04T00:00:00Z",
  "updated_at": "2025-02-04T00:00:00Z",
  "markets": ["BTC/USD", "ETH/USD", "SPY", "QQQ", "AAPL", "TSLA"],
  "timeframes": ["1h", "4h", "1d"],
  "indicators": {
    "market_cipher": {
      "enabled": true,
      "version": "B"
    },
    "algopro": {
      "enabled": false,
      "tools": []
    }
  },
  "entry_rules": {
    "long": {
      "enabled": true,
      "required_signals": ["blue_dot"],
      "confluence_minimum": 2,
      "confluence_signals": [
        "money_flow_green",
        "rsi_oversold",
        "bullish_divergence",
        "support_zone",
        "dbsi_buying"
      ],
      "confirmation": "candle_close",
      "entry_type": "market"
    },
    "short": {
      "enabled": true,
      "required_signals": ["red_x"],
      "confluence_minimum": 2,
      "confluence_signals": [
        "money_flow_red",
        "rsi_overbought",
        "bearish_divergence",
        "resistance_zone",
        "dbsi_selling"
      ],
      "confirmation": "candle_close",
      "entry_type": "market"
    }
  },
  "exit_rules": {
    "take_profit": {
      "type": "risk_reward",
      "value": 2.0
    },
    "stop_loss": {
      "type": "swing_point",
      "buffer_percent": 0.5
    },
    "trailing_stop": {
      "enabled": true,
      "activation_rr": 1.5,
      "trail_type": "percent",
      "trail_value": 1.0
    },
    "time_exit": {
      "enabled": false
    }
  },
  "risk_management": {
    "max_risk_per_trade": 2.0,
    "max_daily_loss": 6.0,
    "max_open_trades": 3,
    "position_sizing": "fixed_risk"
  },
  "filters": {
    "session_filter": {
      "enabled": false
    },
    "volatility_filter": {
      "enabled": false
    },
    "trend_filter": {
      "enabled": true,
      "indicator": "money_flow",
      "settings": {
        "align_with_entry": true
      }
    }
  },
  "notifications": {
    "on_signal": true,
    "on_entry": true,
    "on_exit": true,
    "on_stop_loss": true,
    "channels": ["webhook"]
  }
}
